      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding"
          }
        }
      }
    },
    "workspaces.server.footer": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app praat alleen met deze server en controleert zijn certificaat bij elke verbinding."
          }
        }
      }
    },
    "workspaces.server.secure": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiligd"
          }
        }
      }
    },
    "workspaces.server.user": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingelogd als"
          }
        }
      }
    },
    "workspaces.title": {
      "comment": "Workspaces screen title.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkruimtes"
          }
        }
      }
    },
    "workspaces.unpair.button": {
      "comment": "Destructive button at the bottom of the Workspaces screen: forget the pairing with the server.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontkoppelen"
          }
        }
      }
    },
    "workspaces.unpair.cancel": {
      "comment": "Cancel button in the unpair confirmation.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleren"
          }
        }
      }
    },
    "workspaces.unpair.confirm": {
      "comment": "Destructive button in the unpair confirmation.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontkoppelen"
          }
        }
      }
    },
    "workspaces.unpair.message": {
      "comment": "Unpair confirmation message when no scans wait in the upload queue.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon vergeet de koppeling met je Brievie-server. Je kunt daarna opnieuw koppelen met een nieuwe QR-code."
          }
        }
      }
    },
    "workspaces.unpair.message.queued": {
      "comment": "Unpair confirmation message when scans still wait in the upload queue; %lld is their number.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Er wacht nog %lld scan om te versturen. Die scan wordt van deze telefoon verwijderd. Je kunt daarna opnieuw koppelen met een nieuwe QR-code."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Er wachten nog %lld scans om te versturen. Die scans worden van deze telefoon verwijderd. Je kunt daarna opnieuw koppelen met een nieuwe QR-code."
                }
              }
            }
          }
        }
      }
    },
    "workspaces.unpair.title": {
      "comment": "Title of the confirmation before unpairing.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon ontkoppelen?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
