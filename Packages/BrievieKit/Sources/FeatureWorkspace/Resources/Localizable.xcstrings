{
  "sourceLanguage": "nl",
  "strings": {
    "error.generic": {
      "comment": "Generic error; never shows server diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "workspaces.calendar.footer": {
      "comment": "Explains the calendar switches: what the events contain and where they go.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken met een datum komen in een eigen agenda 'Brievie'. De tekst van de taak en de afzender staan erin, ook als je agenda met iCloud synchroniseert."
          }
        }
      }
    },
    "workspaces.calendar.keep": {
      "comment": "Answer: turn the switch off and keep the calendar.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten staan"
          }
        }
      }
    },
    "workspaces.calendar.noAccess": {
      "comment": "Under the calendar switch when calendar access is refused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie mag niet bij je agenda. Zet het aan in Instellingen."
          }
        }
      }
    },
    "workspaces.calendar.openSettings": {
      "comment": "Button that opens the app's page in Settings, after calendar access was refused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen"
          }
        }
      }
    },
    "workspaces.calendar.remove": {
      "comment": "Answer: turn the switch off and delete the calendar.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen"
          }
        }
      }
    },
    "workspaces.calendar.remove.question": {
      "comment": "Asked when the calendar switch is turned off; %@ is the calendar's name.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda '%@' ook verwijderen?"
          }
        }
      }
    },
    "workspaces.calendar.toggle": {
      "comment": "Switch under a workspace: put its tasks with a deadline in a calendar on this phone.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet deadlines in mijn agenda"
          }
        }
      }
    },
    "workspaces.empty": {
      "comment": "Shown when the list is empty.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog geen werkruimtes."
          }
        }
      }
    },
    "workspaces.error.notVerified": {
      "comment": "Server certificate refused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Koppel de app opnieuw als dit blijft gebeuren."
          }
        }
      }
    },
    "workspaces.error.unreachable": {
      "comment": "Server unreachable.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "workspaces.kind.business": {
      "comment": "Kind of workspace: business.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakelijk"
          }
        }
      }
    },
    "workspaces.kind.home": {
      "comment": "Kind of workspace: home.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuis"
          }
        }
      }
    },
    "workspaces.kind.unknown": {
      "comment": "Kind of workspace the app does not know.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkruimte"
          }
        }
      }
    },
    "workspaces.loading": {
      "comment": "Shown while loading.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkruimtes laden..."
          }
        }
      }
    },
    "workspaces.noPasscode": {
      "comment": "Warning shown when the device cannot lock the app.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft geen toegangscode. Stel een toegangscode in om je post te beschermen."
          }
        }
      }
    },
    "workspaces.retry": {
      "comment": "Retry button after a failed load.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw proberen"
          }
        }
      }
    },
    "workspaces.role.admin": {
      "comment": "Role badge.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheerder"
          }
        }
      }
    },
    "workspaces.role.member": {
      "comment": "Role badge.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lid"
          }
        }
      }
    },
    "workspaces.role.viewer": {
      "comment": "Role badge.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijker"
          }
        }
      }
    },
