{
  "sourceLanguage": "nl",
  "strings": {
    "error.generic": {
      "comment": "Generic error; never shows server diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "home.title": {
      "comment": "Title of the start screen while the workspaces load, could not be loaded, or there are none.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie"
          }
        }
      }
    },
    "reminders.denied": {
      "comment": "Notifications were refused (in the prompt or in Settings).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie isn't allowed to send notifications. Turn on notifications for Brievie in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie mag geen meldingen sturen. Zet meldingen voor Brievie aan in Instellingen."
          }
        }
      }
    },
    "reminders.footer.calendar": {
      "comment": "Footer sentence while a calendar switch is on: its alarms come too.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is 'Put deadlines in my calendar' on as well? Then the calendar also alerts you about deadlines."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat 'Zet termijnen in mijn agenda' ook aan? Dan meldt de agenda de termijnen ook."
          }
        }
      }
    },
    "reminders.footer.dayBefore": {
      "comment": "Footer, first sentence, lead time one day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a notification at 9 am, the day before a deadline and on the day itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt om 9:00 een melding, een dag voordat een termijn afloopt en op de dag zelf."
          }
        }
      }
    },
    "reminders.footer.daysBefore": {
      "comment": "Footer, first sentence; %d is the lead time in days (at least 2).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a notification at 9 am, %d days before a deadline and on the day itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt om 9:00 een melding, %d dagen voordat een termijn afloopt en op de dag zelf."
          }
        }
      }
    },
    "reminders.footer.known": {
      "comment": "Footer: reminders only know what the app last read (no background fetch).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie reminds you of deadlines the app knows about. Open the app now and then to keep that up to date."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie herinnert je aan termijnen die de app kent. Open de app af en toe, dan blijft dat bij."
          }
        }
      }
    },
    "reminders.footer.neutral": {
      "comment": "Footer: what a reminder shows by default (on the lock screen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification only says that a deadline is due, nothing from the letter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de melding staat alleen dat er een termijn afloopt, niets uit de brief."
          }
        }
      }
    },
    "reminders.footer.onTheDay": {
      "comment": "Footer, first sentence, lead time 0 (on the day only).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a notification at 9 am on the day a deadline is due."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt om 9:00 een melding op de dag dat een termijn afloopt."
          }
        }
      }
    },
    "reminders.footer.sender": {
      "comment": "Footer while the sender is shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification also shows the sender. It can then be read on the Lock Screen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de melding staat ook de afzender. Die is dan te lezen op het toegangsscherm."
          }
        }
      }
    },
    "reminders.header": {
      "comment": "Header of the settings section with the deadline reminders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen"
          }
        }
      }
    },
    "reminders.lead": {
      "comment": "Picker: how long before the deadline the first reminder comes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First notification"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste melding"
          }
        }
      }
    },
    "reminders.lead.0": {
      "comment": "Lead time option: only on the day of the deadline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the day itself"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de dag zelf"
          }
        }
      }
    },
    "reminders.lead.1": {
      "comment": "Lead time option.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 day before"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dag ervoor"
          }
        }
      }
    },
    "reminders.lead.2": {
      "comment": "Lead time option.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 days before"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2 dagen ervoor"
          }
        }
      }
    },
    "reminders.lead.3": {
      "comment": "Lead time option (the default).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 days before"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagen ervoor"
          }
        }
      }
    },
    "reminders.lead.7": {
      "comment": "Lead time option.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 week before"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 week ervoor"
          }
        }
      }
    },
    "reminders.openSettings": {
      "comment": "Button that opens the app's page in the Settings app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen"
          }
        }
      }
    },
    "reminders.sender.footer": {
      "comment": "Under the sender switch: what never shows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An amount or what you need to do is never in the notification."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bedrag of wat je moet doen staat nooit in de melding."
          }
        }
      }
    },
    "reminders.sender.toggle": {
      "comment": "Switch, off by default: the notification names the sender.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the sender in notifications"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de afzender in meldingen"
          }
        }
      }
    },
    "reminders.toggle": {
      "comment": "Switch: local notifications for task deadlines on this phone. Off by default. Not \"Herinneringen\" (Apple's Reminders app, the letter type).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadline notifications"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen voor termijnen"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Title of the settings screen, and the accessibility label of the gear that opens it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen"
          }
        }
      }
    },
    "settings.workspace.hint": {
      "comment": "VoiceOver hint on a workspace in the settings that is not the one shown: tapping shows its post.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the letters in this workspace."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de brieven van deze werkruimte."
          }
        }
      }
    },
    "workspaces.calendar.consent.no": {
      "comment": "Answer to the account question: leave the switch off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't turn on"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet aanzetten"
          }
        }
      }
    },
    "workspaces.calendar.consent.question": {
      "comment": "Asked before the calendar goes in an account that is not iCloud or this phone; %@ is the account's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie puts your tasks in the calendar of %@. Whoever manages that account can read them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie zet je taken in de agenda van %@. Wie die account beheert, kan ze lezen."
          }
        }
      }
    },
    "workspaces.calendar.consent.yes": {
      "comment": "Answer to the account question: make the calendar in that account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, put them there"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, zet ze daar"
          }
        }
      }
    },
    "workspaces.calendar.details.footer": {
      "comment": "Under the description switch: who can read the text when it is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The description and the sender will then appear in the calendar. That text can be read on the Lock Screen and by other apps that may read your calendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan staan de omschrijving en de afzender in de agenda. Die tekst is dan te lezen op het toegangsscherm en door andere apps die je agenda mogen lezen."
          }
        }
      }
    },
    "workspaces.calendar.details.toggle": {
      "comment": "Second switch under a calendar switch that is on: put the task's description and sender in the events.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the description in the calendar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de omschrijving in de agenda"
          }
        }
      }
    },
    "workspaces.calendar.footer": {
      "comment": "Under a calendar switch that is off: where its calendar will go; %@ is the calendar's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks with a deadline go in their own calendar '%@' in iCloud or on this iPhone. Brievie only uses another account if you agree."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken met een termijn komen in een eigen agenda '%@' in iCloud of op deze iPhone. Een andere account gebruikt Brievie alleen als jij dat goedvindt."
          }
        }
      }
    },
    "workspaces.calendar.footer.detailed": {
      "comment": "Last sentence under a calendar switch while events show the description and sender.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The description and the sender appear in the calendar. They can also be read on the Lock Screen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De omschrijving en de afzender staan in de agenda. Ook op het toegangsscherm zijn ze te lezen."
          }
        }
      }
    },
    "workspaces.calendar.footer.iCloud": {
      "comment": "Under a calendar switch whose calendar is in iCloud; %@ is the calendar's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks with a deadline are in their own calendar '%@' in iCloud. That calendar also appears on your other devices with iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken met een termijn staan in een eigen agenda '%@' in iCloud. Die agenda staat ook op je andere apparaten met iCloud."
          }
        }
      }
    },
    "workspaces.calendar.footer.local": {
      "comment": "Under a calendar switch whose calendar is on this phone only; %@ is the calendar's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks with a deadline are in their own calendar '%@' on this iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken met een termijn staan in een eigen agenda '%@' op deze iPhone."
          }
        }
      }
    },
    "workspaces.calendar.footer.neutral": {
      "comment": "Last sentence under a calendar switch while events show no description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar and Lock Screen notifications only show the kind of task, such as 'Pay (Brievie)'."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de agenda en bij meldingen op het toegangsscherm staat alleen de soort taak, zoals 'Betalen (Brievie)'."
          }
        }
      }
    },
    "workspaces.calendar.footer.other": {
      "comment": "Under a calendar switch whose calendar is in another account the user agreed to; %1$@ is the calendar's name, %2$@ the account's.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks with a deadline are in their own calendar '%1$@' in the account %2$@. Whoever manages that account can read them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken met een termijn staan in een eigen agenda '%1$@' in de account %2$@. Wie die account beheert, kan ze lezen."
          }
        }
      }
    },
    "workspaces.calendar.keep": {
      "comment": "Answer: turn the switch off and keep the calendar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten staan"
          }
        }
      }
    },
    "workspaces.calendar.keptForUserEvents": {
      "comment": "Under a calendar switch that was turned off with 'Verwijderen' while the calendar also held the user's own events.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calendar also holds your own events. The calendar stays; Brievie's events are gone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze agenda staan ook afspraken van jou. De agenda blijft staan; de afspraken van Brievie zijn weg."
          }
        }
      }
    },
    "workspaces.calendar.noAccess": {
      "comment": "Under the calendar switch when calendar access is refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Brievie access to your calendar in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Brievie toegang tot je agenda in Instellingen."
          }
        }
      }
    },
    "workspaces.calendar.noCalendarAccount": {
      "comment": "Under a calendar switch: the phone has no account a calendar can be made in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no account in which Brievie can create a calendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is op deze telefoon geen account waarin Brievie een agenda kan maken."
          }
        }
      }
    },
    "workspaces.calendar.openSettings": {
      "comment": "Button that opens the app's page in Settings, after calendar access was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen"
          }
        }
      }
    },
    "workspaces.calendar.remove": {
      "comment": "Answer: turn the switch off and delete the calendar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen"
          }
        }
      }
    },
    "workspaces.calendar.remove.question": {
      "comment": "Asked when the calendar switch is turned off; %@ is the calendar's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete calendar '%@' too?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda '%@' ook verwijderen?"
          }
        }
      }
    },
    "workspaces.calendar.sourceGone": {
      "comment": "Under a calendar switch that went off because its calendar's account is no longer on the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account of this calendar is no longer on your phone, so this is now off. Turn it on again to create a new calendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De account van deze agenda staat niet meer op je telefoon. Daarom staat dit nu uit. Zet het weer aan om een nieuwe agenda te maken."
          }
        }
      }
    },
    "workspaces.calendar.tasksNotSupported": {
      "comment": "Under the calendar switch when the server cannot list tasks yet; the switch stays off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server can't pass on tasks yet. Update the server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server kan nog geen taken doorgeven. Werk de server bij."
          }
        }
      }
    },
    "workspaces.calendar.toggle": {
      "comment": "Switch under a workspace: put its tasks with a termijn (deadline) in a calendar on this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put deadlines in my calendar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet termijnen in mijn agenda"
          }
        }
      }
    },
    "workspaces.empty": {
      "comment": "Shown when the list is empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any workspaces yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog geen werkruimtes."
          }
        }
      }
    },
    "workspaces.error.notVerified": {
      "comment": "Server certificate refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check that this is your Brievie server. Pair the app again if this keeps happening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Koppel de app opnieuw als dit blijft gebeuren."
          }
        }
      }
    },
    "workspaces.error.unreachable": {
      "comment": "Server unreachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't reach your Brievie server. Are you on the same network?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "workspaces.kind.business": {
      "comment": "Kind of workspace: business.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Business"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
