{
  "sourceLanguage": "nl",
  "strings": {
    "app.noPasscode": {
      "comment": "Warning on the root screen when the device has no passcode, so the app cannot lock itself.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft geen toegangscode. Stel een toegangscode in om je post te beschermen."
          }
        }
      }
    },
    "calendar.event.neutralTitle": {
      "comment": "Title of a calendar event without details, shown on the lock screen; %@ is the task type (\"Betalen\").",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Brievie)"
          }
        }
      }
    },
    "calendar.name": {
      "comment": "Name of the calendar the app makes per workspace; %@ is the workspace name.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie – %@"
          }
        }
      }
    },
    "calendar.notes.footer": {
      "comment": "Last line of the notes of a deadline in the phone calendar.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit Brievie"
          }
        }
      }
    },
    "error.generic": {
      "comment": "Generic error; never shows server diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "lock.reason": {
      "comment": "Reason shown in the Face ID / passcode prompt.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel Brievie om je post te zien."
          }
        }
      }
    },
    "reminders.body.days": {
      "comment": "Text of a deadline reminder %d days before (at least 2). On the lock screen: nothing from the letter.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn loopt over %d dagen af."
          }
        }
      }
    },
    "reminders.body.sender.days": {
      "comment": "As reminders.body.days, with the sender: %1$@ the sender, %2$d the days.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn van %1$@ loopt over %2$d dagen af."
          }
        }
      }
    },
    "reminders.body.sender.today": {
      "comment": "As reminders.body.today, with the sender (only when the user chose to show it); %@ is the sender.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn van %@ loopt vandaag af."
          }
        }
      }
    },
    "reminders.body.sender.tomorrow": {
      "comment": "As reminders.body.tomorrow, with the sender; %@ is the sender.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn van %@ loopt morgen af."
          }
        }
      }
    },
    "reminders.body.today": {
      "comment": "Text of a deadline reminder on its day. On the lock screen: nothing from the letter.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn loopt vandaag af."
          }
        }
      }
    },
    "reminders.body.tomorrow": {
      "comment": "Text of a deadline reminder one day before. On the lock screen: nothing from the letter.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een termijn loopt morgen af."
          }
        }
      }
    },
    "session.revoked": {
      "comment": "Notice on the pairing screen after the server refused this device: revoked, or expired after a long time unused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppeling werkt niet meer: ze is ingetrokken of je hebt Brievie lang niet gebruikt. Koppel dit toestel opnieuw om verder te gaan."
          }
        }
      }
    },
    "unpair.serverStillKnowsDevice": {
      "comment": "Notice on the pairing screen after unpairing when the server could not be told.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon staat nog als apparaat op de server. Trek hem daar in onder Apparaten."
          }
        }
      }
    }
  },
  "version": "1.0"
}
