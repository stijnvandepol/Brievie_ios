      "localizations": {
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld scan kon niet worden gelezen en is verwijderd."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld scans konden niet worden gelezen en zijn verwijderd."
                }
              }
            }
          }
        }
      }
    },
    "documents.upload.workspaceGone": {
