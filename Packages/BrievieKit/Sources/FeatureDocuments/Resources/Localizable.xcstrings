      "comment": "More pages than the server accepts.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt maximaal 30 pagina's in één keer scannen."
          }
        }
      }
    },
