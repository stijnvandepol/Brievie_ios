{
  "sourceLanguage": "nl",
  "strings": {
    "documents.delete": {
      "comment": "Deletes a scan that is still on the phone.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen"
          }
        }
      }
    },
    "documents.empty": {
      "comment": "Shown when the workspace has no documents.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen post. Scan je eerste brief."
          }
        }
      }
    },
    "documents.error.notFound": {
      "comment": "The document was removed on the server.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document bestaat niet meer."
          }
        }
      }
    },
    "documents.error.notVerified": {
      "comment": "Server certificate refused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Koppel de app opnieuw als dit blijft gebeuren."
          }
        }
      }
    },
    "documents.error.unreachable": {
      "comment": "Server unreachable.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "documents.import": {
      "comment": "Button that picks page photos from the library (no scanner available).",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies foto's"
          }
        }
      }
    },
    "documents.loading": {
      "comment": "Shown while the first load runs.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post laden…"
          }
        }
      }
    },
    "documents.new": {
      "comment": "Title of a document whose sender is not known yet.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuw document"
          }
        }
      }
    },
