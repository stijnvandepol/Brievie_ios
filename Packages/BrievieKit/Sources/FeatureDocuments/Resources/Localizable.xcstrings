      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 pagina"
          }
        }
      }
    },
    "documents.retry": {
      "comment": "Retry button.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw proberen"
          }
        }
      }
    },
    "documents.scan": {
