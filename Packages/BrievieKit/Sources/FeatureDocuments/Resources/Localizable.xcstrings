      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorstel"
          }
        }
      }
    },
    "documents.summary.count": {
      "comment": "One part of the line above Te doen: the row word, then how many.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$d"
          }
        }
      }
    },
    "documents.summary.partial": {
      "comment": "One part of the line above Te doen when only the newest are listed: word, total, number shown.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$d (de nieuwste %3$d)"
          }
        }
      }
    },
    "documents.summary.underway": {
      "comment": "Word for letters and scans on their way in the line above Te doen, as in 'Bezig: 3'.",
