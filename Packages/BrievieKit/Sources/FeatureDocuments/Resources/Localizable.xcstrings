{
  "sourceLanguage": "nl",
  "strings": {
    "document.change.failed": {
      "comment": "A change to a confirmed letter (name, label, suggestion, task) did not reach the server.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit lukte niet. Probeer het opnieuw."
          }
        }
      }
    },
    "document.suggestion.accept": {
      "comment": "Button on an open proposal of a confirmed letter: take it.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen"
          }
        }
      }
    },
    "document.suggestion.dismiss": {
      "comment": "Button on an open proposal of a confirmed letter: drop it.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Negeren"
          }
        }
      }
    },
    "document.suggestion.dismissNamed": {
      "comment": "VoiceOver label of the dismiss button on a proposal, e.g. 'Papa negeren'.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ negeren"
          }
        }
      }
    },
    "document.task.done": {
      "comment": "VoiceOver value of a task's tick box when it is ticked off.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "afgerond"
          }
        }
      }
    },
    "document.task.open": {
      "comment": "VoiceOver value of a task's tick box when it still has to be done.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "open"
          }
        }
      }
    },
    "document.tasks": {
      "comment": "Header above the tasks of a confirmed letter.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken"
          }
        }
      }
    },
    "document.title": {
      "comment": "Title of the screen of a confirmed letter.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brief"
          }
        }
      }
    },
    "documents.add": {
      "comment": "Toolbar menu: add a letter by scanning or from photos.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post toevoegen"
          }
        }
      }
    },
    "documents.addressees": {
      "comment": "Under a letter in the list: the persons it is addressed to, e.g. 'Papa en Mama'.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op naam van %@"
          }
        }
      }
    },
    "documents.all.footer": {
      "comment": "Under the list of Alle post: what the place is for.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je brieven, ook de afgehandelde. Wat nog op jou wacht, staat bij Te doen."
          }
        }
      }
    },
    "documents.automatic": {
      "comment": "Mark on a letter or task the AI handled by itself (the web's wording).",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch door AI"
          }
        }
      }
    },
    "documents.automatic.added": {
      "comment": "Under labels or names the AI or a rule put on a letter by itself. %@ is the list of names.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch toegevoegd: %@"
          }
        }
      }
    },
    "documents.automatic.confirmed": {
      "comment": "Under the mark on a letter the AI confirmed by itself.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI heeft deze brief zelf bevestigd. Niemand heeft hem gecontroleerd."
          }
        }
      }
    },
    "documents.delete": {
      "comment": "Deletes a scan that is still on the phone.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen"
          }
        }
      }
    },
    "documents.empty": {
      "comment": "Shown when the workspace has no documents.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen post. Scan je eerste brief."
          }
        }
      }
    },
    "documents.error.notFound": {
      "comment": "The document was removed on the server.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document bestaat niet meer."
          }
        }
      }
    },
    "documents.error.notVerified": {
      "comment": "Server certificate refused.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Koppel de app opnieuw als dit blijft gebeuren."
          }
        }
      }
    },
    "documents.error.unreachable": {
      "comment": "Server unreachable.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "documents.import": {
      "comment": "Button that picks page photos from the library (no scanner available).",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies foto's"
          }
        }
      }
    },
    "documents.inbox.empty": {
      "comment": "Te doen without letters.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent klaar. Er is niets te doen."
          }
        }
      }
    },
    "documents.inbox.empty.hint": {
      "comment": "Under the empty Te doen, for a viewer (no scan button).",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere brieven vind je bij Alle post."
          }
        }
      }
    },
    "documents.inbox.empty.hintScan": {
      "comment": "Under the empty Te doen, for someone who may scan.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuwe brief scan je met de knop + bovenaan. Eerdere brieven vind je bij Alle post."
          }
        }
      }
    },
    "documents.inbox.footer": {
      "comment": "Under the list of Te doen: what the place is for. Same sentence as the web.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brieven waar jij nog iets mee moet doen. Al je brieven, ook de afgehandelde, staan bij Alle post."
          }
        }
      }
    },
    "documents.inbox.showAll": {
      "comment": "Button under the empty Te doen: shows Alle post.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk Alle post"
          }
        }
      }
