    "documents.error.notFound": {
      "comment": "The document was removed on the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document no longer exists."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document bestaat niet meer."
          }
        }
      }
    },
    "documents.error.notVerified": {
      "comment": "Server certificate refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check that this is your Brievie server. Pair the app again if this keeps happening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Koppel de app opnieuw als dit blijft gebeuren."
          }
        }
      }
    },
    "documents.error.unreachable": {
      "comment": "Server unreachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't reach your Brievie server. Are you on the same network?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "documents.import": {
      "comment": "Button that picks page photos from the library (no scanner available).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies foto's"
          }
        }
      }
    },
    "documents.inbox.empty": {
      "comment": "Te doen without letters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're all caught up. There's nothing to do."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent klaar. Er is niets te doen."
          }
        }
      }
    },
    "documents.inbox.empty.hint": {
      "comment": "Under the empty Te doen, for a viewer (no scan button).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find earlier letters under All mail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere brieven vind je bij Alle post."
          }
        }
      }
    },
    "documents.inbox.empty.hintScan": {
