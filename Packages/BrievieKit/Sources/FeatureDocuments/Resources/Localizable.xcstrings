      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze scan is gemaakt voor een andere server en wordt niet verstuurd. Verwijder hem, of koppel weer met die server."
          }
        }
      }
    },
    "documents.upload.tooLarge": {
      "comment": "Scan above the server's size limit.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze scan is te groot. Scan minder pagina's tegelijk."
          }
        }
      }
    },
    "documents.upload.unreadableRemoved": {
      "comment": "Shown once when scans in the upload queue could not be read and were removed; %lld is their number.",
