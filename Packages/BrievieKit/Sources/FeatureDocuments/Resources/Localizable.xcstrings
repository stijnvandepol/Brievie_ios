          }
        }
      }
    },
    "scan.error.failed": {
      "comment": "Saving the scan failed.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scan kon niet worden bewaard. Probeer het opnieuw."
          }
        }
      }
    },
