    "documents.addressees": {
      "comment": "Under a letter in the list: the persons it is addressed to, e.g. 'Papa en Mama'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addressed to %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op naam van %@"
          }
        }
      }
    },
    "documents.all.footer": {
      "comment": "Under the list of Alle post: what the place is for.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your letters, including the ones you've dealt with. What still needs you is in your Inbox."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je brieven, ook de afgehandelde. Wat nog op jou wacht, staat in je Inbox."
          }
        }
      }
    },
    "documents.automatic": {
      "comment": "Mark on a letter or task the AI handled by itself (the web's wording).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically by AI"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch door AI"
          }
        }
      }
    },
    "documents.automatic.added": {
      "comment": "Under labels or names the AI or a rule put on a letter by itself. %@ is the list of names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added automatically: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch toegevoegd: %@"
          }
        }
      }
    },
    "documents.automatic.confirmed": {
      "comment": "Under the mark on a letter the AI confirmed by itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI confirmed this letter by itself. Nobody has checked it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI heeft deze brief zelf bevestigd. Niemand heeft hem gecontroleerd."
          }
        }
      }
    },
    "documents.delete": {
      "comment": "Deletes a scan that is still on the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen"
          }
        }
      }
