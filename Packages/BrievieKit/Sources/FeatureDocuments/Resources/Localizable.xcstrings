    "documents.empty": {
      "comment": "Shown when the workspace has no documents.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No mail yet. Scan your first letter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen post. Scan je eerste brief."
          }
        }
      }
