{
  "sourceLanguage": "nl",
  "strings": {
    "error.generic": {
      "comment": "Generic error; never shows server diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "pairing.brand": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie"
          }
        }
      }
    },
    "pairing.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie mag de camera niet gebruiken. Zet dit aan in Instellingen, of plak de koppelgegevens."
          }
        }
      },
      "comment": "Shown when camera access was refused."
    },
    "pairing.camera.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen"
          }
        }
      },
      "comment": "Button that opens the app's page in the Settings app."
    },
    "pairing.camera.restricted": {
      "comment": "Shown when the device forbids camera use (Screen Time, MDM).",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is op dit toestel uitgeschakeld. Plak de koppelgegevens."
          }
        }
      }
    },
    "pairing.error.connectionLost": {
      "comment": "Connection dropped after the code was sent.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding viel weg tijdens het koppelen. Maak een nieuwe code en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.incompatible": {
      "comment": "Incompatible API version.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server en de app passen niet bij elkaar. Werk de app of de server bij."
          }
        }
      }
    },
    "pairing.error.invalid": {
      "comment": "QR code is broken.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Brievie-code is niet geldig. Maak een nieuwe code."
          }
        }
      }
    },
    "pairing.error.invalidCode": {
      "comment": "Pairing code rejected.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code is verlopen of al gebruikt. Maak een nieuwe code."
          }
        }
      }
    },
    "pairing.error.notBrievie": {
      "comment": "QR code is not a Brievie code.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen Brievie-code. Open in de webinterface 'App koppelen' en scan de code daar."
          }
        }
      }
    },
    "pairing.error.notVerified": {
      "comment": "Server could not be verified.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Maak een nieuwe code en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.tooManyAttempts": {
      "comment": "Server throttled pairing.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn te veel pogingen gedaan. Wacht even en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.unreachable": {
      "comment": "No server reachable.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "pairing.error.unsupportedVersion": {
      "comment": "QR code has a newer format.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code komt van een nieuwere versie van Brievie. Werk de app bij en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.instructions": {
      "comment": "Pairing screen instructions.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in de webinterface Apparaten en maak een koppelcode."
          }
        }
      }
    },
    "pairing.link.address.check": {
      "comment": "Under the server address: nothing is sent before the user taps Koppel.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is dit niet het adres van jouw server? Sluit dan dit scherm. Er is dan niets verstuurd."
          }
        }
      }
    },
    "pairing.link.address.label": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres van de server"
          }
        }
      }
    },
    "pairing.link.close": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit"
          }
        }
      }
    },
    "pairing.link.code.footer": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de code die op de webpagina staat. Hoofdletters en het streepje maken niet uit. De code zelf gaat niet over het netwerk."
          }
        }
      }
    },
    "pairing.link.code.hint": {
      "comment": "VoiceOver hint of the pairing code field.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de acht tekens van de koppelcode."
          }
        }
      }
    },
    "pairing.link.code.label": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelcode"
          }
        }
      }
    },
    "pairing.link.code.prompt": {
      "comment": "Placeholder of the pairing code field.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "8 tekens"
          }
        }
      }
    },
    "pairing.link.error.alreadyPaired": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon is al gekoppeld met een Brievie-server. Wil je een andere server gebruiken? Tik in Brievie op het tandwiel en dan op Ontkoppelen. Open daarna de link opnieuw."
          }
        }
      }
    },
    "pairing.link.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link werkt niet. Maak op de webpagina een nieuwe koppelcode en open de link opnieuw."
          }
        }
      }
    },
    "pairing.link.error.invalidCode": {
      "comment": "Link sheet: a wrong or used code, or the attempt took too long. One sentence for all of them.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppelcode klopt niet of is verlopen. Typ de code opnieuw, of maak op de webpagina een nieuwe code."
          }
        }
      }
    },
    "pairing.link.error.unsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link komt van een nieuwere versie van Brievie. Werk de app bij en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.link.intro": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een link van je Brievie-server geopend. Hiermee koppel je deze telefoon."
          }
        }
      }
    },
    "pairing.link.question": {
      "comment": "Link sheet: shown when a link opens; nothing has been contacted yet.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je deze telefoon koppelen aan een Brievie-server?"
          }
        }
      }
    },
    "pairing.link.search": {
      "comment": "Link sheet button: only this tap makes the app contact the addresses in the link.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server zoeken"
          }
        }
      }
    },
    "pairing.link.searching": {
      "comment": "Link sheet: the app looks for the server the link names before it asks for the code.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server zoeken…"
          }
        }
      }
    },
    "pairing.link.submit": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel"
          }
        }
      }
    },
    "pairing.link.title": {
      "comment": "Title of the sheet opened by a brievie://server link.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen met je server"
          }
        }
      }
    },
    "pairing.manual.field": {
      "comment": "Label and placeholder of the manual code field.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de koppelgegevens"
          }
        }
      }
    },
    "pairing.manual.header": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelgegevens plakken"
          }
        }
      }
    },
    "pairing.manual.submit": {
      "comment": "Button that pairs with the pasted code.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen"
          }
        }
      }
    },
    "pairing.paste.show": {
      "comment": "Button that shows the manual code field.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak koppelgegevens"
          }
        }
      }
    },
    "pairing.prerequisite.code": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Code geldig"
          }
        }
      }
    },
    "pairing.prerequisite.code.value": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 minuten"
          }
        }
      }
    },
    "pairing.prerequisite.network": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerk"
          }
        }
      }
    },
    "pairing.prerequisite.network.value": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfde wifi als de server"
          }
        }
      }
    },
    "pairing.prerequisites.footer": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app vertrouwt alleen het certificaat van jouw server."
          }
        }
      }
    },
    "pairing.prerequisites.header": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je begint"
          }
        }
      }
    },
    "pairing.progress": {
      "comment": "Shown while pairing.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met koppelen..."
          }
        }
      }
    },
    "pairing.retry": {
      "comment": "Retry button after a failed pairing.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw proberen"
          }
        }
      }
    },
    "pairing.scan": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR-code"
          }
        }
      }
    },
    "pairing.scanner.cancel": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleer"
          }
        }
      }
    },
    "pairing.scanner.label": {
      "comment": "VoiceOver label of the camera view.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera om de QR-code te scannen"
          }
        }
      }
    },
    "pairing.title": {
      "comment": "Pairing screen title.",
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen met je server"
          }
        }
      }
    }
  },
