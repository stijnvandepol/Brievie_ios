{
  "sourceLanguage": "nl",
  "strings": {
    "error.generic": {
      "comment": "Generic error; never shows server diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        }
      }
    },
    "pairing.brand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie"
          }
        }
      }
    },
    "pairing.camera.denied": {
      "comment": "Shown when camera access was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie isn't allowed to use the camera. Turn this on in Settings, or paste the pairing details."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brievie mag de camera niet gebruiken. Zet dit aan in Instellingen, of plak de koppelgegevens."
          }
        }
      }
    },
    "pairing.camera.openSettings": {
      "comment": "Button that opens the app's page in the Settings app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen"
          }
        }
      }
    },
    "pairing.camera.restricted": {
      "comment": "Shown when the device forbids camera use (Screen Time, MDM).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is turned off on this device. Paste the pairing details."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is op dit toestel uitgeschakeld. Plak de koppelgegevens."
          }
        }
      }
    },
    "pairing.error.connectionLost": {
      "comment": "Connection dropped after the code was sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped while pairing. Create a new code and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding viel weg tijdens het koppelen. Maak een nieuwe code en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.incompatible": {
      "comment": "Incompatible API version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server and the app don't match. Update the app or the server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server en de app passen niet bij elkaar. Werk de app of de server bij."
          }
        }
      }
    },
    "pairing.error.invalid": {
      "comment": "QR code is broken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Brievie code isn't valid. Create a new code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Brievie-code is niet geldig. Maak een nieuwe code."
          }
        }
      }
    },
    "pairing.error.invalidCode": {
      "comment": "Pairing code rejected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired or has already been used. Create a new code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code is verlopen of al gebruikt. Maak een nieuwe code."
          }
        }
      }
    },
    "pairing.error.notBrievie": {
      "comment": "QR code is not a Brievie code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a Brievie code. In the web interface, open 'Pair the app' and scan the code there."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen Brievie-code. Open in de webinterface 'App koppelen' en scan de code daar."
          }
        }
      }
    },
    "pairing.error.notVerified": {
      "comment": "Server could not be verified.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check that this is your Brievie server. Create a new code and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden niet controleren of dit jouw Brievie-server is. Maak een nieuwe code en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.pairAtHome": {
      "comment": "The server refused pairing because the phone reached it from outside (403 pair_at_home).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only pair at home or through VPN. Try again when you are at home or have VPN on."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen kan alleen thuis of via VPN. Probeer het opnieuw als je thuis bent of VPN aan hebt."
          }
        }
      }
    },
    "pairing.error.tooManyAttempts": {
      "comment": "Server throttled pairing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There have been too many attempts. Wait a moment and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn te veel pogingen gedaan. Wacht even en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.error.unreachable": {
      "comment": "No server reachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't reach your Brievie server. Are you on the same network?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je Brievie-server niet bereiken. Zit je op hetzelfde netwerk?"
          }
        }
      }
    },
    "pairing.error.unsupportedVersion": {
      "comment": "QR code has a newer format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code comes from a newer version of Brievie. Update the app and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code komt van een nieuwere versie van Brievie. Werk de app bij en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.instructions": {
      "comment": "Pairing screen instructions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the web interface, open Devices and create a pairing code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in de webinterface Apparaten en maak een koppelcode."
          }
        }
      }
    },
    "pairing.link.address.check": {
      "comment": "Under the server address: nothing is sent before the user taps Koppel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isn't this your server's address? Then close this screen. Nothing has been sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is dit niet het adres van jouw server? Sluit dan dit scherm. Er is dan niets verstuurd."
          }
        }
      }
    },
    "pairing.link.address.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server address"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres van de server"
          }
        }
      }
    },
    "pairing.link.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit"
          }
        }
      }
    },
    "pairing.link.code.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the code shown on the web page. Capital letters and the hyphen don't matter. The code itself doesn't travel over the network."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de code die op de webpagina staat. Hoofdletters en het streepje maken niet uit. De code zelf gaat niet over het netwerk."
          }
        }
      }
    },
    "pairing.link.code.hint": {
      "comment": "VoiceOver hint of the pairing code field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the eight characters of the pairing code."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de acht tekens van de koppelcode."
          }
        }
      }
    },
    "pairing.link.code.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing code"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelcode"
          }
        }
      }
    },
    "pairing.link.code.prompt": {
      "comment": "Placeholder of the pairing code field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 characters"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "8 tekens"
          }
        }
      }
    },
    "pairing.link.error.alreadyPaired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is already paired with a Brievie server. Want to use a different server? In Brievie, tap the gear and then Unpair. Then open the link again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon is al gekoppeld met een Brievie-server. Wil je een andere server gebruiken? Tik in Brievie op het tandwiel en dan op Ontkoppelen. Open daarna de link opnieuw."
          }
        }
      }
    },
    "pairing.link.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link doesn't work. Create a new pairing code on the web page and open the link again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link werkt niet. Maak op de webpagina een nieuwe koppelcode en open de link opnieuw."
          }
        }
      }
    },
    "pairing.link.error.invalidCode": {
      "comment": "Link sheet: a wrong or used code, or the attempt took too long. One sentence for all of them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing code is wrong or has expired. Type the code again, or create a new code on the web page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze koppelcode klopt niet of is verlopen. Typ de code opnieuw, of maak op de webpagina een nieuwe code."
          }
        }
      }
    },
    "pairing.link.error.unsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link comes from a newer version of Brievie. Update the app and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link komt van een nieuwere versie van Brievie. Werk de app bij en probeer het opnieuw."
          }
        }
      }
    },
    "pairing.link.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened a link from your Brievie server. You can use it to pair this phone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een link van je Brievie-server geopend. Hiermee koppel je deze telefoon."
          }
        }
      }
    },
    "pairing.link.name.footer": {
      "comment": "Under the phone's name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how the server names this phone, under Devices. That way you'll know later which phone is which."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo heet deze telefoon op de server, bij Apparaten. Zo weet je later welke telefoon welke is."
          }
        }
      }
    },
    "pairing.link.name.label": {
      "comment": "Header and label of the field with the name the server shows for this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name of this phone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naam van deze telefoon"
          }
        }
      }
    },
    "pairing.link.name.prompt": {
      "comment": "Placeholder of the phone's name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, Jesse's iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijvoorbeeld iPhone van Jesse"
          }
        }
      }
    },
    "pairing.link.question": {
      "comment": "Link sheet: shown when a link opens; nothing has been contacted yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to pair this phone with a Brievie server?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je deze telefoon koppelen aan een Brievie-server?"
          }
        }
      }
    },
    "pairing.link.search": {
      "comment": "Link sheet button: only this tap makes the app contact the addresses in the link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server zoeken"
          }
        }
      }
    },
    "pairing.link.searching": {
      "comment": "Link sheet: the app looks for the server the link names before it asks for the code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding server…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server zoeken…"
          }
        }
      }
    },
    "pairing.link.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel"
          }
        }
      }
    },
    "pairing.link.title": {
      "comment": "Title of the sheet opened by a brievie://server link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with your server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen met je server"
          }
        }
      }
    },
    "pairing.manual.field": {
      "comment": "Label and placeholder of the manual code field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the pairing details"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de koppelgegevens"
          }
        }
      }
    },
    "pairing.manual.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste pairing details"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelgegevens plakken"
          }
        }
      }
    },
    "pairing.manual.submit": {
      "comment": "Button that pairs with the pasted code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen"
          }
        }
      }
    },
    "pairing.ownPhone": {
      "comment": "Under the scan button of the pairing screen: each person pairs their own phone with their own account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pair your own phone. Someone who uses another phone pairs it with their own account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel alleen je eigen telefoon. Wie een andere telefoon gebruikt, koppelt die met een eigen account."
          }
        }
      }
    },
    "pairing.paste.show": {
      "comment": "Button that shows the manual code field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste pairing details"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak koppelgegevens"
          }
        }
      }
    },
    "pairing.prerequisite.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code valid for"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Code geldig"
          }
        }
      }
    },
    "pairing.prerequisite.code.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 minutes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 minuten"
          }
        }
      }
    },
    "pairing.prerequisite.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerk"
          }
        }
      }
    },
    "pairing.prerequisite.network.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same Wi-Fi as the server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfde wifi als de server"
          }
        }
      }
    },
    "pairing.prerequisites.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app only trusts your own server's certificate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app vertrouwt alleen het certificaat van jouw server."
          }
        }
      }
    },
    "pairing.prerequisites.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je begint"
          }
        }
      }
    },
    "pairing.progress": {
      "comment": "Shown while pairing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing..."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met koppelen..."
          }
        }
      }
    },
    "pairing.retry": {
      "comment": "Retry button after a failed pairing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw proberen"
          }
        }
      }
    },
    "pairing.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR code"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR-code"
          }
        }
      }
    },
    "pairing.scanner.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleer"
          }
        }
      }
    },
    "pairing.scanner.label": {
      "comment": "VoiceOver label of the camera view.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera for scanning the QR code"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera om de QR-code te scannen"
          }
        }
      }
